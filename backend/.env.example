NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/lionlink
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_INVITE_CODE=replace-with-a-private-admin-code
CLIENT_ORIGIN=https://your-project.pages.dev
APP_URL=https://your-project.pages.dev
# Google Cloud OAuth web-client credentials. Add
# https://your-api-host/api/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Create this key at resend.com/api-keys and verify the sender domain in Resend.
RESEND_API_KEY=re_your_resend_api_key
MAIL_FROM=Lion Link <noreply@yourdomain.com>
